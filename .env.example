# Copy to .env and fill in. Never commit .env.

# --- LiveKit -----------------------------------------------------------------
# Local dev server (`livekit-server --dev`) uses these fixed dev credentials.
# For LiveKit Cloud: wss://<your-project>.livekit.cloud plus the project's key/secret.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# URL the browser connects to, if different from LIVEKIT_URL (optional)
# LIVEKIT_PUBLIC_URL=
# The worker registers under this name; the web token dispatches it into each call.
AGENT_NAME=morning-brief

# --- Speech-to-text ------------------------------------------------------------
STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=your-assemblyai-key
# STT_MODEL=universal-3-6-pro
# Words the recognizer should expect (names, product terms), comma-separated
# STT_KEYTERMS=Claude,morning brief,annual plan,annual maintenance plan,tickets,Riverside Clinic

# --- Turn detection (when has the caller finished?) ---------------------------
# "model" = LiveKit's end-of-turn model; "stt" = AssemblyAI's signal; "vad" = silence only
TURN_DETECTION=model
# v1-mini runs locally/offline; on LiveKit Cloud use v1 (hosted, more accurate)
TURN_DETECTOR_VERSION=v1-mini
# Seconds of silence before answering when the sentence sounds finished / unfinished
ENDPOINTING_MIN_DELAY=1.2
ENDPOINTING_MAX_DELAY=2.0
# TURN_UNLIKELY_THRESHOLD=      # raise (e.g. 0.5) to wait more often on unfinished-sounding speech

# --- LLM ------------------------------------------------------------------------
# Claude through the Anthropic API. The same key is used by the Claude skill webhook.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=your-anthropic-key
# How long Claude thinks before it speaks: low (default, fastest) | medium | high
# LLM_EFFORT=low
#
# Or any OpenAI-compatible endpoint (OpenRouter, OpenAI, Groq, a self-hosted vLLM):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-5.5
# OPENROUTER_API_KEY=your-openrouter-key   # or LLM_API_KEY for another provider
# LLM_TEMPERATURE=0.4
# Retry a request that sends nothing for this many seconds (default 10 in LiveKit)
# LLM_TIMEOUT_SECONDS=6

# --- Text-to-speech -------------------------------------------------------------
# "assemblyai" (streaming, lowest latency) or "gemini" (needs GOOGLE_API_KEY)
TTS_PROVIDER=assemblyai
# Voice id/slug for AssemblyAI, or a Gemini voice name such as Kore, Puck, Charon
# TTS_VOICE=
# TTS_MODEL=
# TTS_TIMEOUT_SECONDS=2
GOOGLE_API_KEY=your-gemini-key

# --- Prompt and greeting ---------------------------------------------------------
# PROMPT_FILE=voice_agent/prompt.md
# GREETING=Good morning! Want me to run through your morning brief?

# --- Data sources ---------------------------------------------------------------
KNOWLEDGE_BASE_DIR=knowledge_base
INTERNAL_API_URL=http://127.0.0.1:8001
INTERNAL_API_TOKEN=change-me-random-string
# INTERNAL_API_TIMEOUT_SECONDS=5

# --- Webhook to the internal Claude setup -------------------------------------
CLAUDE_WEBHOOK_URL=http://127.0.0.1:8002/skills/run
WEBHOOK_SECRET=change-me-another-random-string
WEBHOOK_TIMEOUT_SECONDS=25
CLAUDE_SKILL_NAME=ticket_triage_summary
# Used by the demo webhook service (services/claude_webhook.py) only:
# CLAUDE_SKILL_MODEL=claude-sonnet-5-5
# CLAUDE_SKILL_EFFORT=low

# --- Web page -----------------------------------------------------------------
# If set, the page only works as https://your-host/?code=<this value>
# WEB_ACCESS_CODE=
