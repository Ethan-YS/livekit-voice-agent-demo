# Copy to .env and fill in. Never commit .env.

# --- LiveKit -----------------------------------------------------------------
# Local dev server (`livekit-server --dev`) uses these fixed dev credentials.
# For LiveKit Cloud: wss://<your-project>.livekit.cloud plus the project's key/secret.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# URL the browser connects to, if different from LIVEKIT_URL (optional)
# LIVEKIT_PUBLIC_URL=
# The worker registers under this name; the web token dispatches it into each call.
AGENT_NAME=morning-brief

# --- Speech-to-text ------------------------------------------------------------
STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=your-assemblyai-key
# STT_MODEL=universal-3-6-pro
# "stt" = AssemblyAI's end-of-turn model decides when you stopped talking; "vad" = silence only
TURN_DETECTION=stt

# --- LLM (any OpenAI-compatible endpoint) -------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_API_KEY=your-openrouter-key
# LLM_API_KEY=            # use instead of OPENROUTER_API_KEY for another provider
# LLM_TEMPERATURE=0.4

# --- Text-to-speech -------------------------------------------------------------
# "assemblyai" (streaming, lowest latency) or "gemini" (needs GOOGLE_API_KEY)
TTS_PROVIDER=assemblyai
# Voice id/slug for AssemblyAI, or a Gemini voice name such as Kore, Puck, Charon
# TTS_VOICE=
# TTS_MODEL=
GOOGLE_API_KEY=your-gemini-key

# --- Prompt and greeting ---------------------------------------------------------
# PROMPT_FILE=voice_agent/prompt.md
# GREETING=Good morning! Want me to run through your morning brief?

# --- Data sources ---------------------------------------------------------------
KNOWLEDGE_BASE_DIR=knowledge_base
INTERNAL_API_URL=http://127.0.0.1:8001
INTERNAL_API_TOKEN=change-me-random-string
# INTERNAL_API_TIMEOUT_SECONDS=5

# --- Webhook to the internal Claude setup -------------------------------------
CLAUDE_WEBHOOK_URL=http://127.0.0.1:8002/skills/run
WEBHOOK_SECRET=change-me-another-random-string
WEBHOOK_TIMEOUT_SECONDS=25
CLAUDE_SKILL_NAME=ticket_triage_summary
# Used by the demo webhook service (services/claude_webhook.py) only:
# CLAUDE_SKILL_MODEL=anthropic/claude-sonnet-5.5
# CLAUDE_API_BASE=https://openrouter.ai/api/v1

# --- Web page -----------------------------------------------------------------
# If set, the page only works as https://your-host/?code=<this value>
# WEB_ACCESS_CODE=
